{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/luka-waronig/agent-identity-node/main/schemas/policy.schema.json",
  "title": "Agent Identity Node Capability Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role",
    "tool_policy",
    "broadcast_policy",
    "task_policy",
    "vault_policy",
    "provider_policy"
  ],
  "properties": {
    "schema_version": { "const": "agent-node/v0alpha1" },
    "role": { "type": "string", "minLength": 1 },
    "tool_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_tools", "denied_tools"],
      "properties": {
        "allowed_tools": { "type": "array", "items": { "type": "string" } },
        "denied_tools": { "type": "array", "items": { "type": "string" } }
      }
    },
    "broadcast_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow_agent_broadcasts", "max_payload_bytes"],
      "properties": {
        "allow_agent_broadcasts": { "type": "boolean" },
        "max_payload_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "task_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_announce",
        "allow_claim",
        "allow_complete",
        "allow_verify",
        "allowed_requested_roles"
      ],
      "properties": {
        "allow_announce": { "type": "boolean" },
        "allow_claim": { "type": "boolean" },
        "allow_complete": { "type": "boolean" },
        "allow_verify": { "type": "boolean" },
        "allowed_requested_roles": { "type": "array", "items": { "type": "string" } }
      }
    },
    "vault_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vault_dir", "allow_read", "allow_list", "allow_write"],
      "properties": {
        "vault_dir": { "type": "string", "minLength": 1 },
        "allow_read": { "type": "boolean" },
        "allow_list": { "type": "boolean" },
        "allow_write": { "type": "boolean" }
      }
    },
    "provider_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_providers", "allowed_models", "allow_local", "allow_cloud"],
      "properties": {
        "allowed_providers": { "type": "array", "items": { "type": "string" } },
        "allowed_models": { "type": "array", "items": { "type": "string" } },
        "allow_local": { "type": "boolean" },
        "allow_cloud": { "type": "boolean" }
      }
    }
  }
}
